MINIMAX_API_KEY=your_api_key_here
MINIMAX_GROUP_ID=your_group_id_here
MINIMAX_APPLICATION_ANALYSIS_RETRY_ATTEMPTS=3
MINIMAX_APPLICATION_ANALYSIS_RETRY_BACKOFF_SECONDS=2
MINIMAX_APPLICATION_ANALYSIS_RETRY_MAX_BACKOFF_SECONDS=30
VITE_API_BASE=http://localhost:5000
VITE_DOWNLOADER_API_BASE=https://downloader-api.bhwa233.com

# Postgres (本地 Docker 5432 -> host 25432)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:25432/postgres
SQLALCHEMY_ECHO=false
